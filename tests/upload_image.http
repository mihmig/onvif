### Отправка картинки: шаг 1 - получение URL для загрузки
#Доступные форматы: JPG, JPEG, PNG, GIF, TIFF, BMP, HEIC
#Максимальный размер одного изображения: до 50 МБ или не более 7680 x 7680 px
POST https://platform-api.max.ru/uploads?type=image
Authorization: {{bot_token}}
Content-Type: application/json

> {%
    client.global.set("upload_url", response.body.url);
%}


### Шаг 2: загрузка файла:
### https://iu.oneme.ru/uploadImage?apiToken=6MqMkSQ6wD4appvNdfnPD7DCRFCjRcuVq4%2F24HGTOn1bxG9%2FPIlQQDdQp844r0iCQx9Uj%2BXupfI0S%2FDS%2FoSqjoC%2BYQQ6ZVIjNguoB%2BS%2FH7ghB4HotoN9Ja8SZ10ZbeoqQB%2BjMGl5tNxRYP%2B8QGGMgA%3D%3D&photoIds=oFT8EsjzS4faddZxQD0qRWmm74JYfv7zL3VYODpzeAZHRwg6%2FM0lGg%3D%3D
POST {{upload_url}}
Authorization: {access_token}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="data"; filename="image.png"
Content-Type: image/png

< ../data/dog.jpg
--WebAppBoundary--

> {%
    client.global.set("token", Object.values(response.body.photos)[0].token);
%}

