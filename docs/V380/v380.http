### Создаём подписку
POST {{base_url}}/onvif/event_service
Content-Type: application/soap+xml; charset=utf-8

<?xml version="1.0" encoding="UTF-8"?>
<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" xmlns:tev="http://www.onvif.org/ver10/events/wsdl" xmlns:wsnt="http://docs.oasis-open.org/wsn/b-2">
<s:Body>
<tev:CreatePullPointSubscription>
    <wsnt:InitialTerminationTime>PT600S</wsnt:InitialTerminationTime>
</tev:CreatePullPointSubscription>
</s:Body>
</s:Envelope>


### Получаем события
POST {{base_url}}/event_service/0
Content-Type: application/soap+xml; charset=utf-8

<?xml version="1.0" encoding="UTF-8"?>
<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope"
            xmlns:tev="http://www.onvif.org/ver10/events/wsdl">
    <s:Body>
        <tev:PullMessages>
            <tev:Timeout>PT10S</tev:Timeout>
            <tev:MessageLimit>10</tev:MessageLimit>
        </tev:PullMessages>
    </s:Body>
</s:Envelope>


### Снимок
GET {{base_url}}/snapshot/PROFILE_001